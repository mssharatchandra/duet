{
  "uid": "duet-bench",
  "title": "Duet — benchmark & calls",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Duet vs cascaded baseline (all runs)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 7 },
      "datasource": { "type": "postgres", "uid": "duet-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT mode, count(*) AS calls, round(avg(takeover_rate)::numeric, 3) AS takeover_rate, round(avg(overlap_ratio)::numeric, 3) AS overlap_ratio, round(avg(response_latency_ms_p50)::numeric) AS handoff_p50_ms, round(avg(response_latency_ms_p95)::numeric) AS handoff_p95_ms, round(avg(cost_per_min_usd)::numeric, 4) AS usd_per_min FROM calls GROUP BY mode ORDER BY mode;"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Handoff latency p95 (ms) per call",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "duet-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", response_latency_ms_p95 AS value, mode AS metric FROM calls ORDER BY ts;"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Takeover rate per call",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "postgres", "uid": "duet-pg" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS \"time\", takeover_rate AS value, mode AS metric FROM calls ORDER BY ts;"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Reasoning cost (USD, all calls)",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "duet-pg" },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT coalesce(sum(reasoning_cost_usd), 0) FROM calls;" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Total calls",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 5 },
      "datasource": { "type": "postgres", "uid": "duet-pg" },
      "targets": [{ "refId": "A", "format": "table", "rawSql": "SELECT count(*) FROM calls;" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Live sessions",
      "gridPos": { "x": 0, "y": 20, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "duet-prom" },
      "targets": [{ "refId": "A", "expr": "sum(duet_sessions_active)", "legendFormat": "active" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Live response latency p50 / p95",
      "gridPos": { "x": 6, "y": 20, "w": 18, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "duet-prom" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(duet_response_latency_ms_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(duet_response_latency_ms_bucket[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Reasoning and TTS latency p95",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "duet-prom" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(duet_reasoning_latency_ms_bucket[5m])))", "legendFormat": "reasoning" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(duet_tts_first_audio_latency_ms_bucket[5m])))", "legendFormat": "tts first audio" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors and interruptions",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "duet-prom" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(duet_errors_total[5m]))", "legendFormat": "errors/s" },
        { "refId": "B", "expr": "sum(rate(duet_interruptions_total[5m]))", "legendFormat": "interruptions/s" }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Correlated live-session events (content redacted by default)",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "duet-loki" },
      "targets": [{ "refId": "A", "expr": "{job=\"duet-live\"}", "queryType": "range" }]
    }
  ]
}
