# Duet environment configuration
# Copy to .env and fill in. Never commit .env.
# Everything here is optional until the phase that needs it — Phase 1 runs fully local with no keys.

# --- Phase 2: async reasoning layer ---
# The one paid API dependency we accept on principle.
GEMINI_API_KEY=
# Optional override; default is gemini-3.1-flash-lite (see DECISIONS.md 0005)
# REASONING_MODEL=gemini-3.5-flash

# Sarvam streaming speech (cloud); when the key is set, Sarvam ASR/TTS become
# the browser defaults. Parakeet/Piper remain the offline fallback.
SARVAM_API_KEY=
# ASR_ENGINE=sarvam
# TTS_BACKEND=sarvam-ws
# SARVAM_LANGUAGE=en-IN
# SARVAM_MODE=transcribe
# SARVAM_STT=realtime
# SARVAM_SILENCE_MS=220
# TURN_GRACE_MS=450
# Calm, warm Aira defaults. Bulbul v3 defines 1.0 as natural pace.
# SARVAM_SPEAKER=simran
# SARVAM_TTS_PACE=1.04
# SARVAM_TTS_TEMPERATURE=0.72

# ASBL action capability. `local` writes accepted demo requests to an ignored
# JSONL ledger; set `remote` plus the gateway URL to use the internal product.
ASBL_ACTION_MODE=local
# ASBL_ACTION_LEDGER=.local/asbl-actions.jsonl
# ASBL_ACTION_GATEWAY_URL=https://internal.example.com/voice-actions
# ASBL_ACTION_GATEWAY_TOKEN=

# Local fallback tuning.
# ASR_MIN_RMS=0.003
# VAD_THRESHOLD=0.55
# VAD_MIN_SPEECH_MS=160

# --- Phase 3: observability (self-hosted stack in infra/; dev defaults match infra/.env.example) ---
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-duet-dev
LANGFUSE_SECRET_KEY=sk-lf-duet-dev
# Privacy default: traces/logs contain hashes and character counts, not speech text.
# Enable only for an explicitly consented local eval session.
DUET_TRACE_CONTENT=false
DUET_LOG_PARTIALS=false
DUET_TELEMETRY_LOG=.local/telemetry/events.jsonl
# GPU pricing assumption for published $/min (RunPod L4-class; see DECISIONS.md 0007)
# GPU_USD_PER_HOUR=0.40

# --- Phase 3/4: local infra (docker-compose defaults) ---
DATABASE_URL=postgresql://duet:duet@localhost:5433/duet
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=

# --- Phase 4: demo limits ---
SESSION_MAX_SECONDS=240          # hard server-side cap per demo call
SESSIONS_PER_EMAIL_PER_DAY=1
SESSION_LIMIT_PER_IP_HOUR=3      # admission attempts; checked before WebSocket upgrade
SESSION_LIMIT_PER_IP_DAY=10
# Loopback is unlimited during native development. The container deploy profile
# disables this because the reverse proxy forwards the caller's real IP.
ALLOW_LOOPBACK_UNLIMITED_SESSIONS=true

# Gemini quotas are per Google Cloud project, not per key. Google now directs
# developers to AI Studio for each project's active limits. Keep these below
# the values shown there. Excess work is rejected rather than delaying audio.
GEMINI_RPM_LIMIT=8
GEMINI_RPD_LIMIT=100
GEMINI_CONCURRENT_LIMIT=1
GEMINI_QUOTA_STATE_PATH=.local/quota/gemini.json

# Public reverse-proxy deployment. Do not trust proxy headers when exposing
# the Python process directly.
# TRUST_PROXY=true
# ALLOWED_ORIGINS=https://voice.example.com
